# Database Configuration
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite123
POSTGRES_DB=brewlite
POSTGRES_PORT=5433
DATABASE_URL="postgresql://brewlite:brewlite123@localhost:5433/brewlite?schema=public"

# Backend (apps/api)
PORT=3001
JWT_SECRET=brewlite-super-secret-key-change-in-production
JWT_EXPIRATION=1d
# Production CORS whitelist (comma-separated, e.g. https://brewlite.vercel.app)
CORS_ORIGIN=

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Docker Buildx bypass (for Windows users)
BUILDX_BAKE_ENTITLEMENTS_FS=0

# PayOS Configuration (Optional - bỏ dấu `#` và điền key PayOS của bạn nếu muốn test VietQR thật)
# PAYOS_CLIENT_ID="<your-payos-client-id>"
# PAYOS_API_KEY="<your-payos-api-key>"
# PAYOS_CHECKSUM_KEY="<your-payos-checksum-key>"

# MoMo Configuration (Optional - bỏ dấu `#` và điền key MoMo Sandbox của bạn nếu muốn test MoMo)
# MOMO_PARTNER_CODE="MOMO"
# MOMO_ACCESS_KEY="<your-momo-sandbox-access-key>"
# MOMO_SECRET_KEY="<your-momo-sandbox-secret-key>"
# MOMO_API_URL="https://test-payment.momo.vn/v2/gateway/api/create"
# MOMO_IPN_URL="http://localhost:3001/api/payments/momo-ipn"
