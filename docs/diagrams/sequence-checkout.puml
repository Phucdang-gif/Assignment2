@startuml sequence-checkout
!theme plain
skinparam shadowing false
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 12
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #1E40AF
}
skinparam actor {
    BackgroundColor #EFF6FF
    BorderColor #1E40AF
}
skinparam sequence {
    LifeLineBorderColor #64748B
    GroupBorderColor #2563EB
    ArrowColor #1E3A8A
}

title Sequence Diagram - UC: Đặt và thanh toán đơn hàng (Task 2.2, theo Use-case Task 1.3)

actor "Khách hàng\n(Customer)" as C
participant "Next.js UI" as UI
participant "NestJS API" as API
database "Database\n(PostgreSQL/Prisma)" as DB
participant "Payment Service\n(PayOS / MoMo)" as PAY

== 1. Bắt đầu đặt hàng & kiểm tra JWT ==
C -> UI : Bấm "Thanh toán" tại /cart\n(có thể nhập mã voucher)
activate UI
UI -> UI : Kiểm tra giỏ hàng & JWT trong useAuthStore
alt Giỏ hàng rỗng (E1)
    UI --> C : Hiển thị giỏ hàng trống
else Chưa đăng nhập / không có token (E2)
    UI --> C : Chuyển hướng /login?redirect=/cart\n(giữ giỏ hàng ở LocalStorage)
else Giỏ hàng hợp lệ và có token
    UI -> API : GET /api/orders/voucher/:code?subtotal=... (nếu có mã)
    API --> UI : Chiết khấu voucher (nếu hợp lệ)

    == 2. Tạo đơn hàng (Transaction) ==
    UI -> API : POST /api/orders\n(Bearer JWT, items, voucherCode)
    activate API
    API -> API : JwtAuthGuard: verify chữ ký & hạn token (exp)
    alt Token không hợp lệ / hết hạn (HTTP 401)
        API --> UI : 401 Unauthorized
        UI --> C : Xóa token, chuyển hướng /login?redirect=/cart
    else Token hợp lệ
        API -> API : Gắn userId vào Request.user\nValidate DTO & tính lại giá từ DB
        alt Dữ liệu không hợp lệ (HTTP 400)
            API --> UI : 400 Bad Request (chi tiết lỗi)
            UI --> C : Hiển thị lỗi, giữ nguyên giỏ hàng
        else Dữ liệu hợp lệ
            API -> DB : BEGIN prisma.$transaction
            activate DB
            API -> DB : Đọc công thức ProductRecipeItem,\ntồn kho nguyên liệu (Ingredient), version sản phẩm
            DB --> API : recipe, Ingredient.stock, Product.version
            alt Thiếu nguyên liệu hoặc xung đột version (E3)
                API -> DB : ROLLBACK
                DB --> API : Đã hoàn tác toàn bộ
                deactivate DB
                API --> UI : 400 / 409 "Nguyên liệu không đủ hoặc xung đột"
                UI --> C : Cảnh báo banner đỏ, yêu cầu chỉnh giỏ hàng
            else Đủ nguyên liệu tồn kho
                API -> DB : UPDATE ingredient SET stock = stock - needed\nUPDATE products SET version = version + 1 WHERE version = :v
                API -> DB : INSERT Order (PENDING, subtotal, discount, total),\nOrderItem, OrderItemTopping
                API -> DB : COMMIT
                DB --> API : orderId, total
                deactivate DB
                API --> UI : 201 Created (orderId, total)
                UI -> UI : Chuyển sang /checkout (giữ đơn 5 phút)

                == 3. Thanh toán & idempotency ==
                C -> UI : Chọn phương thức, bấm "Xác nhận thanh toán"
                UI -> UI : Sinh idempotencyKey (UUID v4)
                UI -> API : POST /api/payments\n(Bearer JWT, orderId, method, amount, idempotencyKey)
                API -> API : Verify JWT & validate dữ liệu
                API -> DB : Tìm Payment theo idempotencyKey
                DB --> API : Kết quả tra cứu

                alt idempotencyKey đã tồn tại trong DB (A2 - client gửi lại / bấm 2 lần)
                    API --> UI : 200 OK (kết quả giao dịch cũ, idempotent: true)\nKHÔNG gọi Payment Service, KHÔNG trừ tiền lần 2
                    UI --> C : Thông báo thanh toán thành công (kết quả cũ)
                else idempotencyKey chưa tồn tại
                    API -> PAY : Yêu cầu trừ tiền (orderId, amount, idempotencyKey)
                    activate PAY
                    alt Thanh toán thành công (SUCCESS)
                        PAY --> API : SUCCESS, transactionRef
                        deactivate PAY
                        API -> DB : BEGIN transaction
                        activate DB
                        API -> DB : Lưu Payment (idempotencyKey, amount, method, SUCCESS)\nUPDATE Order -> PAID\nUPDATE User.loyaltyPoints += floor(total / 10000)\nINSERT LoyaltyTransaction (EARN, balanceAfter)
                        API -> DB : COMMIT
                        DB --> API : OK
                        deactivate DB
                        API --> UI : 200/201 (PAID, pointsEarned)
                        UI -> UI : clearCart()
                        UI --> C : Chuyển sang /orders/:id (ĐÃ THANH TOÁN)
                    else Thanh toán bị từ chối / Hủy đơn (E4)
                        PAY --> API : FAILED / CANCELLED
                        API -> DB : BEGIN transaction
                        activate DB
                        API -> DB : UPDATE Order -> PAYMENT_FAILED / CANCELLED\nHoàn trả tồn kho nguyên liệu (Ingredient.stock += needed)
                        API -> DB : COMMIT
                        DB --> API : OK
                        deactivate DB
                        API --> UI : 400 / 402 Payment Failed
                        UI --> C : Báo lỗi thanh toán, hoàn món về giỏ hàng
                    else Cổng thanh toán timeout (E5)
                        PAY --> API : (không phản hồi) 504 Gateway Timeout
                        deactivate PAY
                        API --> UI : 504 Gateway Timeout\n(đơn giữ PENDING chờ đối soát)
                        UI --> C : Thông báo "Đang chờ xác nhận thanh toán",\nthử lại với cùng idempotencyKey
                    end
                end
            end
        end
    end
end
deactivate API
deactivate UI
@enduml
