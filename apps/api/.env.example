# Database
DATABASE_URL="postgresql://brewlite:brewlite123@localhost:5433/brewlite?schema=public"

# Auth / JWT
JWT_SECRET="brewlite-super-secret-key-change-in-production"
JWT_EXPIRATION="1d"

# Backend
PORT=3001
CORS_ORIGIN=""
FRONTEND_URL="http://localhost:3000"

# PayOS Configuration (VietQR payment gateway - Optional)
# Để mặc định (đã comment) sẽ dùng Mock Payment có sẵn (`POST /api/payments`).
# Nếu muốn test cổng VietQR PayOS thật, bỏ dấu `#` và điền key tài khoản PayOS của bạn (xem apps/api/PAYMENT_SETUP.md):
# PAYOS_CLIENT_ID="<your-payos-client-id>"
# PAYOS_API_KEY="<your-payos-api-key>"
# PAYOS_CHECKSUM_KEY="<your-payos-checksum-key>"

# MoMo Configuration (Testing Sandbox - Optional)
# Để mặc định (đã comment) nếu chưa dùng ví MoMo Sandbox.
# Nếu muốn test redirect MoMo Sandbox, bỏ dấu `#` và điền key MoMo Sandbox của bạn:
# MOMO_PARTNER_CODE="MOMO"
# MOMO_ACCESS_KEY="<your-momo-sandbox-access-key>"
# MOMO_SECRET_KEY="<your-momo-sandbox-secret-key>"
# MOMO_API_URL="https://test-payment.momo.vn/v2/gateway/api/create"
# MOMO_IPN_URL="http://localhost:3001/api/payments/momo-ipn"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
