generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        BigInt       @id @default(autoincrement())
  userId    BigInt
  status    order_status @default(PENDING)
  total     Decimal      @default(0) @db.Decimal(12, 2)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @db.Timestamptz(6)
  User      User         @relation(fields: [userId], references: [id], onUpdate: NoAction)
  OrderItem OrderItem[]
  Payment   Payment[]

  @@index([status], map: "idx_order_status")
  @@index([userId], map: "idx_order_userid")
}

model OrderItem {
  id               BigInt             @id @default(autoincrement())
  orderId          BigInt
  productId        BigInt
  size             product_size
  qty              Int
  lineTotal        Decimal            @db.Decimal(12, 2)
  Order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Product          Product            @relation(fields: [productId], references: [id], onUpdate: NoAction)
  OrderItemTopping OrderItemTopping[]

  @@index([orderId], map: "idx_orderitem_orderid")
  @@index([productId], map: "idx_orderitem_productid")
}

model Payment {
  id             BigInt         @id @default(autoincrement())
  orderId        BigInt
  idempotencyKey String         @unique @db.VarChar(255)
  amount         Decimal        @db.Decimal(12, 2)
  method         payment_method
  Order          Order          @relation(fields: [orderId], references: [id], onUpdate: NoAction)

  @@index([orderId], map: "idx_payment_orderid")
}

model Product {
  id         BigInt        @id @default(autoincrement())
  categoryId Int?
  name       String        @db.VarChar(255)
  price      Decimal       @db.Decimal(12, 2)
  imageUrl    String?       @db.VarChar(500)
  description String?       @db.Text
  stock      Int           @default(0)
  version    Int           @default(0)
  status     ProductStatus @default(active)
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @default(now()) @db.Timestamptz(6)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  OrderItem  OrderItem[]
  ProductRecipeItem ProductRecipeItem[]

  @@index([categoryId], map: "idx_product_categoryid")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @db.Timestamptz(6)
  products  Product[]
}

model User {
  id            BigInt    @id @default(autoincrement())
  fullName      String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(15)
  passwordHash  String    @db.VarChar(255)
  loyaltyPoints Int       @default(0)
  role          user_role @default(customer)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  Order         Order[]
}

enum user_role {
  customer
  barista
}

enum order_status {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum payment_method {
  WALLET
  CARD
}

enum product_size {
  S
  M
  L
}

enum ProductStatus {
  active
  inactive
}

model OrderItemTopping {
  orderItemId BigInt
  toppingId   Int
  priceAtTime Int
  OrderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Topping     Topping   @relation(fields: [toppingId], references: [id], onUpdate: NoAction)

  @@id([orderItemId, toppingId])
}

model Topping {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(255)
  price            Int
  isAvailable      Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  OrderItemTopping OrderItemTopping[]
}

model Ingredient {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  unit              String              @db.VarChar(20)
  stock             Float               @default(0)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  ProductRecipeItem ProductRecipeItem[]
}

model ProductRecipeItem {
  id           Int          @id @default(autoincrement())
  productId    BigInt
  size         product_size
  ingredientId Int
  amount       Float
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  Product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, size, ingredientId], name: "uq_product_size_ingredient")
  @@index([productId, size], map: "idx_recipe_product_size")
}

