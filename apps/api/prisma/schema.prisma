generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum user_role {
  customer
  barista
  admin
}

enum order_status {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum payment_method {
  WALLET
  CARD
}

enum payment_status {
  SUCCESS
  FAILED
}

enum product_size {
  S
  M
  L
}

enum ProductStatus {
  active
  inactive
}

enum discount_type {
  PERCENTAGE
  FIXED_AMOUNT
  MEMBERSHIP_TIER
}

enum loyalty_type {
  EARN
  REDEEM
  ADJUST
}

model User {
  id                 BigInt               @id @default(autoincrement())
  fullName           String?              @db.VarChar(100)
  email              String               @unique @db.VarChar(255)
  phone              String?              @unique @db.VarChar(15)
  passwordHash       String               @db.VarChar(255)
  loyaltyPoints      Int                  @default(0)
  role               user_role            @default(customer)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  Order              Order[]
  LoyaltyTransaction LoyaltyTransaction[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  products  Product[]
}

model Product {
  id                BigInt              @id @default(autoincrement())
  categoryId        Int?
  name              String              @db.VarChar(255)
  price             Decimal             @db.Decimal(12, 2)
  imageUrl          String?             @db.VarChar(500)
  description       String?             @db.Text
  version           Int                 @default(0)
  status            ProductStatus       @default(active)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @db.Timestamptz(6)
  category          Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  OrderItem         OrderItem[]
  ProductRecipeItem ProductRecipeItem[]

  @@index([categoryId], map: "idx_product_categoryid")
}

model Topping {
  id               Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(255)
  price            Int
  isAvailable      Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  OrderItemTopping OrderItemTopping[]
}

model Ingredient {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(255)
  unit              String              @db.VarChar(20)
  stock             Int                 @default(0)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  ProductRecipeItem ProductRecipeItem[]
}

model ProductRecipeItem {
  id           Int          @id @default(autoincrement())
  productId    BigInt
  size         product_size
  ingredientId Int
  amount       Int
  unit         String       @db.VarChar(20)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  Product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([productId, size, ingredientId], name: "uq_product_size_ingredient")
  @@index([productId, size], map: "idx_recipe_product_size")
}

model Promotion {
  id            BigInt        @id @default(autoincrement())
  code          String        @unique @db.VarChar(50)
  description   String?       @db.Text
  discountType  discount_type
  discountValue Decimal       @db.Decimal(12, 2)
  minOrderValue Decimal       @default(0) @db.Decimal(12, 2)
  startDate     DateTime      @db.Timestamptz(6)
  endDate       DateTime      @db.Timestamptz(6)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  Order         Order[]

  @@index([code], map: "idx_promotion_code")
}

model Order {
  id                 BigInt               @id @default(autoincrement())
  userId             BigInt
  promotionId        BigInt?
  status             order_status         @default(PENDING)
  subtotal           Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @default(0) @db.Decimal(12, 2)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @db.Timestamptz(6)
  User               User                 @relation(fields: [userId], references: [id], onUpdate: NoAction)
  Promotion          Promotion?           @relation(fields: [promotionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  OrderItem          OrderItem[]
  Payment            Payment[]
  LoyaltyTransaction LoyaltyTransaction[]

  @@index([status], map: "idx_order_status")
  @@index([userId], map: "idx_order_userid")
  @@index([promotionId], map: "idx_order_promotionid")
}

model OrderItem {
  id               BigInt             @id @default(autoincrement())
  orderId          BigInt
  productId        BigInt
  size             product_size
  qty              Int
  unitPrice        Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal            @db.Decimal(12, 2)
  Order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Product          Product            @relation(fields: [productId], references: [id], onUpdate: NoAction)
  OrderItemTopping OrderItemTopping[]

  @@index([orderId], map: "idx_orderitem_orderid")
  @@index([productId], map: "idx_orderitem_productid")
}

model OrderItemTopping {
  orderItemId BigInt
  toppingId   Int
  priceAtTime Int
  OrderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Topping     Topping   @relation(fields: [toppingId], references: [id], onUpdate: NoAction)

  @@id([orderItemId, toppingId])
}

model Payment {
  id             BigInt         @id @default(autoincrement())
  orderId        BigInt
  idempotencyKey String         @unique @db.VarChar(255)
  amount         Decimal        @db.Decimal(12, 2)
  method         payment_method
  status         payment_status @default(SUCCESS)
  transactionRef String?        @db.VarChar(255)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  Order          Order          @relation(fields: [orderId], references: [id], onUpdate: NoAction)

  @@index([orderId], map: "idx_payment_orderid")
}

model LoyaltyTransaction {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt
  orderId      BigInt?
  points       Int
  type         loyalty_type
  balanceAfter Int
  reason       String?      @db.VarChar(255)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  User         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId], map: "idx_loyalty_userid")
  @@index([orderId], map: "idx_loyalty_orderid")
}
